{
  "name": "reticlexr",
  "version": "1.2.0",
  "description": "Reticle XR (reticlexr) is a high-level augmented reality SDK for React and Capacitor: place 3D models on real surfaces with hit testing, plane detection, anchors, tap-to-place, touch gestures, runtime recolouring and screenshots. WebXR + Three.js (GLB) on Android/web, and native ARKit + RealityKit (USDZ) on iOS.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js",
      "default": "./src/react.js"
    },
    "./web": {
      "types": "./src/web.d.ts",
      "import": "./src/web.js",
      "default": "./src/web.js"
    },
    "./ar-view": {
      "types": "./src/ar-view.d.ts",
      "import": "./src/ar-view.js",
      "default": "./src/ar-view.js"
    },
    "./gestures": {
      "types": "./src/gestures.d.ts",
      "import": "./src/gestures.js",
      "default": "./src/gestures.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/index.js"
  ],
  "scripts": {
    "check-types": "tsc --noEmit --checkJs",
    "test": "vitest run"
  },
  "files": [
    "android/",
    "ios/",
    "src/",
    "Package.swift",
    "Reticlexr.podspec"
  ],
  "author": "ShahiCrafts",
  "license": "MIT",
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShahiCrafts/reticlexr.git"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "arcore",
    "ar",
    "augmented-reality",
    "android",
    "react",
    "webxr",
    "webar",
    "web-ar",
    "immersive-ar",
    "xr",
    "3d",
    "threejs",
    "three.js",
    "hit-test",
    "plane-detection",
    "anchors",
    "glb",
    "gltf",
    "3d-models",
    "ar-sdk",
    "sdk",
    "typescript",
    "mobile-ar",
    "product-viewer",
    "spatial-computing",
    "ios",
    "arkit",
    "realitykit",
    "usdz"
  ],
  "peerDependencies": {
    "@capacitor/core": "^8.5.2",
    "react": ">=16.8.0",
    "three": "^0.180.0"
  },
  "bugs": {
    "url": "https://github.com/ShahiCrafts/reticlexr/issues"
  },
  "homepage": "https://reticlexr.vercel.app",
  "devDependencies": {
    "@capacitor/core": "^8.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.180.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
