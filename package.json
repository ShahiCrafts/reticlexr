{
  "name": "reticlexr",
  "version": "1.0.0",
  "description": "High-level AR abstraction for Capacitor and React with WebXR, ARCore, Three.js, gestures, model customization, and DOM overlays.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js",
      "default": "./src/react.js"
    },
    "./web": {
      "types": "./src/web.d.ts",
      "import": "./src/web.js",
      "default": "./src/web.js"
    },
    "./ar-view": {
      "types": "./src/ar-view.d.ts",
      "import": "./src/ar-view.js",
      "default": "./src/ar-view.js"
    },
    "./gestures": {
      "types": "./src/gestures.d.ts",
      "import": "./src/gestures.js",
      "default": "./src/gestures.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/index.js",
    "./src/hooks.js"
  ],
  "scripts": {
    "check-types": "tsc --noEmit --checkJs"
  },
  "files": [
    "android/",
    "src/"
  ],
  "author": "ShahiCrafts",
  "license": "MIT",
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShahiCrafts/reticlexr.git"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "arcore",
    "ar",
    "augmented-reality",
    "android",
    "react",
    "webxr",
    "3d",
    "threejs"
  ],
  "peerDependencies": {
    "@capacitor/core": "^8.5.2",
    "react": ">=16.8.0",
    "three": "^0.180.0"
  },
  "bugs": {
    "url": "https://github.com/ShahiCrafts/reticlexr/issues"
  },
  "homepage": "https://reticlexr.vercel.app",
  "devDependencies": {
    "@capacitor/core": "^8.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.180.0",
    "typescript": "^5.9.3"
  }
}
